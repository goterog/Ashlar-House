# =========================================
# DESARROLLO LOCAL (COPIAR A .env)
# =========================================
NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# Base de datos SQLite (desarrollo)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Strapi Security Keys (usar valores únicos por entorno)
APP_KEYS="your-random-app-key-1,your-random-app-key-2,your-random-app-key-3,your-random-app-key-4"
API_TOKEN_SALT="your-random-api-token-salt"
ADMIN_JWT_SECRET="your-random-admin-jwt-secret"
TRANSFER_TOKEN_SALT="your-random-transfer-token-salt"
JWT_SECRET="your-random-jwt-secret"
ENCRYPTION_KEY="your-random-encryption-key"

# WhatsApp CallMeBot Configuration
CALLMEBOT_API_KEY_1=your-callmebot-key-1
CALLMEBOT_API_KEY_2=your-callmebot-key-2

# EmailJS Configuration
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
WEBHOOKS_POPULATE_RELATIONS=false

# =========================================
# PRODUCCIÓN (RAILWAY) - REFERENCIA
# =========================================
# NODE_ENV=production
# PORT=3000
# DATABASE_URL=postgresql://... (Railway)
# FRONTEND_URL=https://ashlar-house.vercel.app