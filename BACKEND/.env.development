# =========================================
# DESARROLLO LOCAL - WINDOWS/MACOS/LINUX
# =========================================

# Configuración del entorno
NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# Base de datos SQLite (desarrollo)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Strapi Security Keys (desarrollo - NO usar en producción)
APP_KEYS="dev-key-1,dev-key-2,dev-key-3,dev-key-4"
API_TOKEN_SALT="dev-api-token-salt-32-characters"
ADMIN_JWT_SECRET="dev-admin-jwt-secret-32-characters"
TRANSFER_TOKEN_SALT="dev-transfer-salt-32-characters"
JWT_SECRET="dev-jwt-secret-32-characters"
ENCRYPTION_KEY="dev-encryption-key-32-characters"

# WhatsApp CallMeBot Configuration (desarrollo) - reemplazar con tus claves locales
CALLMEBOT_API_KEY_1=your-callmebot-key-1
CALLMEBOT_API_KEY_2=your-callmebot-key-2
CALLMEBOT_PHONE_1=+5215500000001
CALLMEBOT_PHONE_2=+5215500000002

# Airbnb sync (iCal URL del listado)
AIRBNB_ICS_URL=https://www.airbnb.mx/calendar/ical/your-listing.ics?s=your-token

# EmailJS Configuration (desarrollo)
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id

# Frontend URL (desarrollo)
FRONTEND_URL=http://localhost:3000

# Webhooks
WEBHOOKS_POPULATE_RELATIONS=false
